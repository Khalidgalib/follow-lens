<?xml version="1.0" encoding="utf-8"?>
<!-- Same geometry as GalivoMark.kt's ImageVector, scaled down and centered so it survives
     adaptive-icon masking (circle/squircle/rounded-square) on every launcher without clipping. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <path
            android:pathData="M74.5,70.6 A32,32 0 1 1 80.1,39.1"
            android:strokeColor="#FFCB57"
            android:strokeWidth="14"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M81,55 L63,55 L63,67"
            android:strokeColor="#FFCB57"
            android:strokeWidth="14"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
